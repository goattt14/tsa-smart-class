# =============================================================================
# TSA Platform — environment reference (never commit a filled-in .env)
# Backend vars live in apps/api/.env  |  Frontend vars live in apps/web/.env
# =============================================================================

# ----------------------------- BACKEND (Render) ------------------------------
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata
LOG_LEVEL=debug

# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/tsa?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/tsa?sslmode=require&connect_timeout=15"

# openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-min-32-chars-access-secret"
JWT_REFRESH_SECRET="change-me-min-32-chars-refresh-secret"
COOKIE_SECRET="change-me-min-32-chars-cookie-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

APP_NAME="The Scholastic Academy"
APP_WEB_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"
ALLOW_VERCEL_PREVIEWS=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12

# AI layer — mock keeps every academic feature working with zero API keys.
AI_PROVIDER=mock
AI_TEXT_MODEL=""
AI_FAST_MODEL=""
AI_EMBEDDING_MODEL=""
AI_EMBEDDING_DIM=1536
AI_MAX_OUTPUT_TOKENS=2000
AI_TIMEOUT_MS=45000
AI_DAILY_TOKEN_BUDGET=500000
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# RAG
PGVECTOR_ENABLED=true
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.25

# Storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=""
SIGNED_URL_TTL_SEC=900
MAX_UPLOAD_MB=25

# Notifications — npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
MAIL_DRIVER=console
MAIL_FROM="TSA <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMS_DRIVER=console

# Payments — mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Demo seeding
SEED_DEMO=true
DEMO_PASSWORD="Tsa@Demo2026"

# ----------------------------- FRONTEND (Vercel) -----------------------------
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_APP_NAME="The Scholastic Academy"
VITE_APP_SHORT_NAME="TSA"
VITE_APP_TAGLINE="strive for success"
VITE_PRIMARY_COLOR="#5CB82B"
VITE_SECONDARY_COLOR="#101418"
VITE_ACCENT_COLOR="#E8A317"
VITE_LOGO_URL="/logo.svg"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
VITE_ENABLE_PROCTORING=true
VITE_ENABLE_VOICE_VIVA=true
VITE_ENABLE_PUSH=true
VITE_VAPID_PUBLIC_KEY=""
VITE_FACE_MODEL_BASE_URL="https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
VITE_DEMO_MODE=true
