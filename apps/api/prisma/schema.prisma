// =============================================================================
// TSA — The Scholastic Academy
// Smart Class Management & AI Personalised Learning Platform
// Prisma schema (PostgreSQL / Neon)
// -----------------------------------------------------------------------------
// Conventions
//   * All tables snake_case via @@map, all columns camelCase in client.
//   * Times of day are stored as INTEGER minutes-from-midnight (0..1439).
//     This keeps the self-study scheduling engine timezone-safe and makes
//     range comparisons index-friendly. Dates use DateTime @db.Date.
//   * Soft delete = deletedAt (nullable). Hard delete is reserved for GDPR/DPDP
//     erasure requests, executed through a dedicated service.
//   * Vector embeddings use pgvector. The column is Unsupported() because the
//     Prisma Client cannot map it; all reads/writes go through $queryRaw in
//     src/modules/rag/vector.repository.ts. A JSON fallback column keeps the
//     system working on a Postgres instance without the extension.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  // debian-openssl-3.0.x is required for Render's build image. Without it the
  // classic "Query engine library for current platform could not be found"
  // error appears at runtime on Render.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // Neon pooled connection (pgbouncer)
  directUrl  = env("DIRECT_URL")   // Neon direct connection, used by migrate
  extensions = [vector, pgcrypto]
}

