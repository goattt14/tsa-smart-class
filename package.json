{
  "name": "tsa-smart-class",
  "version": "0.1.0",
  "private": true,
  "description": "TSA — Smart Class Management & AI Personalised Learning Platform",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "start:api": "npm run start --workspace apps/api",
    "db:generate": "npm run db:generate --workspace apps/api",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:deploy": "npm run db:deploy --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "db:studio": "npm run db:studio --workspace apps/api",
    "db:reset": "npm run db:reset --workspace apps/api",
    "test": "npm run test --workspace apps/api",
    "typecheck": "npm run typecheck --workspace apps/api && npm run typecheck --workspace apps/web",
    "lint": "npm run lint --workspace apps/api && npm run lint --workspace apps/web",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "@types/node-cron": "^3.0.11",
    "concurrently": "^9.1.0",
    "prettier": "^3.3.3"
  }
}
